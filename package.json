{
  "name": "rivian-spotter",
  "version": "2026.42.23",
  "private": true,
  "description": "Independent directory of Rivian places across North America",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ci": "npm test && npm run build",
    "refresh:data": "node scripts/refresh-locations.cjs",
    "generate:data": "node scripts/generate-data.cjs",
    "refresh:charging": "node scripts/refresh-charging.mjs",
    "refresh:all": "node scripts/refresh-all.mjs",
    "refresh:roamer": "node scripts/refresh-roamer.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "mapbox-gl": "3.33.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "cheerio": "^1.2.0",
    "pbf": "5.1.2"
  }
}
