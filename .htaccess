# Optional Apache mirror only. GitHub Pages does not evaluate this file.
# Publish dist, never the repository root or private source/configuration files.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:api/|contact-handler\.php$) - [G,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:tests|docs|scripts|node_modules)/ - [F,L]
</IfModule>
<FilesMatch "^(?:\.env(?:\..*)?|package(?:-lock)?\.json|.*\.(?:md|sh|log|map))$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(?:html|json|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
AddDefaultCharset UTF-8
